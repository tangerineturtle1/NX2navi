#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
// Write-back by difference of a VRAM mirror's large written ranges (vk_memory.c, wb_merge_record with
// NX2NAVI_WB_DIFF). 16 invocations cover a 64-byte line of consecutive words; when the GPU changed any word of it
// against the snapshot taken before the submission's GPU work, they copy the whole line, else nothing. Whole lines keep
// the writes into guest memory across PCIe in full packets and spare the memory controller a read-modify-write (the
// merge's word-sized writes cost it); a line the GPU left alone keeps what the CPU wrote meanwhile.
// One invocation per word; ranges sorted by their first invocation (x: word offset in the mirror and imported bindings,
// y: word offset in the snapshot binding, z: words, w: first invocation, w = x mod 32 so that the clusters of 16 line up
// with the 64-byte lines of the 128-byte aligned bindings; the invocations before a range's w are idle).
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Post { uint post[]; };
layout(std430, set = 0, binding = 1) readonly buffer Pre { uint pre[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Dst { uint dst[]; };
layout(std430, set = 0, binding = 3) readonly buffer Ranges { uvec4 rng[]; };
layout(push_constant) uniform Push { uint nranges, total; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lo = 0u, hi = pc.nranges;
    while (hi - lo > 1u) {
        uint m = (lo + hi) >> 1;
        if (rng[m].w <= i) lo = m;
        else hi = m;
    }
    uvec4 r = rng[lo];
    uint k = i - r.w;   // past the range's words (the padding before the next one): idle
    bool live = i < pc.total && i >= r.w && k < r.z;
    uint v = 0u;
    bool ch = false;
    if (live) {
        v = post[r.x + k];
        ch = v != pre[r.y + k];
    }
    bool any = subgroupClusteredOr(ch ? 1u : 0u, 16u) != 0u;
    if (live && any) dst[r.x + k] = v;
}
