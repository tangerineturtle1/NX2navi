#version 450
// Copies a merge list (shaders/wb_mergelist.comp: a 16-byte header with the count, then 8-byte entries) from
// device-local memory to host memory for the completion thread (vk_memory.c merge_apply): 16 bytes an invocation, the
// invocations of a subgroup consecutive, so the writes across PCIe go out in whole lines.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uvec4 src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uvec4 dst[]; };
layout(push_constant) uniform Push { uint cap; } pc;

void main() {
    uint n = min(src[0].x, pc.cap);
    uint chunks = 1u + (n + 1u) / 2u;   // the header and n entries
    for (uint i = gl_GlobalInvocationID.x; i < chunks; i += gl_NumWorkGroups.x * 256u) dst[i] = src[i];
}
