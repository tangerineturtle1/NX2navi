+        // The statement of block that holds node (node itself when it is in block), null when block does not hold it;
+        // crossesLoop: a loop lies between them.
+        private static IAstNode StatementIn(AstBlock block, IAstNode node, out bool crossesLoop)
+        {
+            crossesLoop = false;
+
+            while (node != null)
+            {
+                AstBlock parent = node is AstBlock b ? b.Parent : ParentBlock(node);
+
+                if (parent == block)
+                {
+                    return node;
+                }
+
+                if (parent == null)
+                {
+                    return null;
+                }
+
+                if (parent.Type == AstBlockType.DoWhile)
+                {
+                    crossesLoop = true;
+                }
+
+                node = parent;
+            }
+
+            return null;
+        }
+
+        // Whether node a comes before node b, both statements of block.
+        private static bool Before(AstBlock block, IAstNode a, IAstNode b)
+        {
+            foreach (IAstNode node in block)
+            {
+                if (node == a)
+                {
+                    return node != b;
+                }
+
+                if (node == b)
+                {
+                    return false;
+                }
+            }
+
+            return false;
+        }
